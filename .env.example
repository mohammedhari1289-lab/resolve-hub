# PostgreSQL connection string (matches docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/resolvehub?schema=public"

# Secret used to sign login cookies. Generate one with:  openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string-of-32-plus-characters"

# Public site URL (used for SEO: canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
